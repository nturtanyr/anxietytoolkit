<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".JournalNavigation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/button_goals"
            android:layout_width="341dp"
            android:layout_height="63dp"
            android:layout_marginTop="32dp"
            android:text="Goals"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gratitude_daily" />

        <Button
            android:id="@+id/gratitude_daily"
            android:layout_width="341dp"
            android:layout_height="63dp"
            android:layout_marginTop="32dp"
            android:text="Daily Gratitude"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button_mooddaily" />

        <Button
            android:id="@+id/button_mooddaily"
            android:layout_width="341dp"
            android:layout_height="63dp"
            android:layout_marginTop="32dp"
            android:onClick="onButtonDailyMood"
            android:text="Daily Mood"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>